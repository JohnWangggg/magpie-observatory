{
  "name": "magpie-observatory",
  "version": "0.6.0",
  "description": "A monitoring cockpit for Magpie: live routing with two-way magpies, quotas, usage, 4 views, 4 style packs and layout settings.",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "server.mjs",
    "public",
    "page",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
